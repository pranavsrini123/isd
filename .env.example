# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the PUBLIC anon key belongs here. Never put the service_role key in
# any VITE_ variable: everything prefixed VITE_ is shipped to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: shown in the UI; the real restriction lives in the database
# setting allowed_email_domains (Admin → Settings).
VITE_APP_NAME=ISD Lab
